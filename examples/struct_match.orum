# struct_match.orum — Orum v0.013 example
# Structs, integer-payload unions, string equality, and match arms.

struct Point
x: int
y: int
end

point = Point(x: 10, y: 20)
say(point.x)

fn load_value(source: str) -> int | int
if source == "ok"
return ok(10)
else
return err(20)
end
end

match load_value("nope")
ok(value) -> say(value)
err(problem) -> say(problem)
end
